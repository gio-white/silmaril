---
import archivoLatin from '../assets/fonts/archivo-latin.woff2';
import publicSansLatin from '../assets/fonts/public-sans-latin.woff2';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { locales, localeTags, localizePath, stripLocale, toLocale, useTranslations } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path-relative OG image; falls back to the site-wide card. */
  image?: string;
  /** False for the 404 page: no canonical, no alternates, and noindex. */
  indexable?: boolean;
}

const { title, description, image = '/og.png', indexable = true } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Every page exists in every locale, so each one lists all of them as
// alternates, with English as the x-default.
const barePath = stripLocale(Astro.url.pathname);
const alternates = locales.map((alt) => ({
  hreflang: localeTags[alt].lang,
  href: new URL(localizePath(barePath, alt), Astro.site).href,
}));
const hasAxis = Astro.slots.has('axis');
---

<!doctype html>
<html lang={localeTags[locale].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {
      indexable ? (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((alt) => (
            <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }

    <!-- Overwritten at runtime by theme.ts so mobile browser chrome tracks the
         active theme. The static value here is the light background. -->
    <meta name="theme-color" content="#edf0f2" />

    <!-- Open Graph is the point of prerendering: Slack, LinkedIn and WhatsApp
         build the preview card without executing any JavaScript. -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeTags[locale].og} />
    {
      locales
        .filter((alt) => alt !== locale)
        .map((alt) => <meta property="og:locale:alternate" content={localeTags[alt].og} />)
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <slot name="head" />

    <!-- Only the two above-the-fold faces are preloaded. Mono and the latin-ext
         subsets load on demand. -->
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link
      rel="preload"
      href={publicSansLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!--
      The only blocking script on the site, and it earns it: without setting
      the theme before first paint, every dark-mode visitor gets a white flash
      on every navigation.

      It also detects scroll-driven animation support here rather than later,
      because the IntersectionObserver fallback hides elements before revealing
      them - deciding that after paint would itself cause a flash.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
        } catch {}
        if (!(window.CSS && CSS.supports('animation-timeline: view()'))) {
          root.dataset.revealJs = '';
        }
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">{t.layout.skipLink}</a>

    <header class="site-header">
      <div class="site-header__inner">
        <Nav />
        <div class="site-header__tools">
          <LanguageSwitch />
          <ThemeToggle />
        </div>
      </div>
    </header>

    <div class:list={['shell', { 'shell--axis': hasAxis }]}>
      {hasAxis && <div class="shell__axis"><slot name="axis" /></div>}
      <main id="main" class="shell__main">
        <slot />
      </main>
    </div>

    <SiteFooter />

    <script>
      import { initReveal } from '../scripts/reveal';

      initReveal();
    </script>

    <style>
      .skip-link {
        position: absolute;
        z-index: var(--z-skip-link);
        inset-block-start: var(--space-2xs);
        inset-inline-start: var(--space-2xs);
        padding: var(--space-2xs) var(--space-s);
        background-color: var(--color-surface);
        color: var(--color-text);
        border: var(--border-hair) solid var(--color-accent);
        border-radius: var(--radius-md);
        transform: translateY(-200%);
      }

      .skip-link:focus-visible {
        transform: none;
      }

      .site-header {
        position: sticky;
        inset-block-start: 0;
        z-index: var(--z-header);
        background-color: color-mix(in oklab, var(--color-bg) 88%, transparent);
        backdrop-filter: blur(8px);
        border-block-end: var(--border-hair) solid var(--color-rule);
      }

      /* Phone landscape: a sticky header plus a tall hero eats the whole
       * screen. Unpin the header and let the page scroll as a normal document. */
      @media (orientation: landscape) and (max-height: 40rem) {
        .site-header {
          position: static;
        }

        .site-header__inner {
          padding-block: 2px;
        }
      }

      .site-header__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2xs) var(--space-s);
        max-inline-size: var(--width-content);
        margin-inline: auto;
        padding: var(--space-2xs) var(--gutter);
      }

      .site-header__tools {
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
      }

      .shell {
        max-inline-size: var(--width-content);
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      /* The axis takes its own column only where there is horizontal room for
       * it. Below 64rem --axis-width is 0 and the gutter hides itself, so the
       * single-column rule here is what actually applies. */
      @media (min-width: 64rem) {
        .shell--axis {
          display: grid;
          grid-template-columns: var(--axis-width) minmax(0, 1fr);
          gap: var(--space-xl);
          align-items: start;
        }
      }

      .shell__main {
        min-inline-size: 0;
      }
    </style>
  </body>
</html>
