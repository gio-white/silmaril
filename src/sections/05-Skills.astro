---
import Section from '../components/Section.astro';
import TagList from '../components/TagList.astro';
import { localizePath, toLocale, useTranslations } from '../i18n';
import { getSkills, isFallback } from '../lib/content';

/**
 * No proficiency bars, star ratings or percentages. They are a cliché, and
 * they are not honest — nobody can defend "Python 87%".
 */
interface Props {
  limit?: number;
  as?: 'h1' | 'h2';
}

const { limit, as } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const all = await getSkills(locale);
const groups = limit ? all.slice(0, limit) : all;
const truncated = groups.length < all.length;
const fallback = groups.some((group) => isFallback(group, locale));
---

<Section
  id="skills"
  label={t.skills.label}
  title={t.skills.title}
  as={as}
  fallback={fallback}
  viewAll={truncated ? { href: localizePath('/skills', locale), text: t.skills.full } : undefined}
>
  <dl class="skills">
    {
      groups.map((group) => (
        <div class="skills__group">
          <dt class="skills__label label">{group.data.group}</dt>
          <dd class="skills__items">
            <TagList items={group.data.items} label={group.data.group} />
          </dd>
        </div>
      ))
    }
  </dl>
</Section>

<style>
  .skills {
    display: grid;
    gap: 0;
    margin: 0;
    border-block-start: var(--border-hair) solid var(--color-rule);
  }

  .skills__group {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-s);
    border-block-end: var(--border-hair) solid var(--color-rule);
  }

  @media (min-width: 48rem) {
    .skills__group {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-l);
      align-items: baseline;
    }
  }

  .skills__label {
    margin: 0;
  }

  .skills__items {
    margin: 0;
  }
</style>
