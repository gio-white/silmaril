---
import AxisGutter from '../components/AxisGutter.astro';
import { axisSiteItems } from '../data/nav';
import { profile } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../sections/07-Contact.astro';

/**
 * Cloudflare Pages serves dist/404.html, with a 404 status, for any path that
 * matches no file. It ends with the contact section like every other page, so
 * the header's #contact link still resolves here.
 */
---

<BaseLayout title={`Page not found — ${profile.name}`} description="This page does not exist.">
  <AxisGutter slot="axis" items={axisSiteItems} mode="site" />

  <section class="missing" aria-labelledby="missing-heading">
    <p class="label missing__code">404</p>
    <h1 id="missing-heading" class="missing__title">Nothing plotted here</h1>
    <p class="missing__text">
      The page you asked for does not exist, or it has moved. The home page has everything in one
      place.
    </p>
    <p class="missing__actions">
      <a class="link" href="/">Back to the home page</a>
      <a class="link" href="#contact">Get in touch</a>
    </p>
  </section>

  <Contact />
</BaseLayout>

<style>
  .missing {
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-2xl) var(--space-section);
  }

  .missing__code {
    color: var(--color-accent);
  }

  .missing__title {
    font-size: var(--text-3xl);
  }

  .missing__text {
    max-inline-size: 48ch;
    font-size: var(--text-md);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .missing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    margin-block-start: var(--space-xs);
  }
</style>
