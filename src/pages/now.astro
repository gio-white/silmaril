---
import { getEntry, render } from 'astro:content';
import AxisGutter from '../components/AxisGutter.astro';
import { axisSiteItems } from '../data/nav';
import { profile } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../sections/07-Contact.astro';

/**
 * A /now page (nownownow.com): what Giorgio is focused on at the moment. One
 * Markdown file, src/content/now/en.md; its `updated` date is shown, because a
 * /now page without a date cannot be trusted.
 */
const entry = await getEntry('now', 'en');
if (!entry) throw new Error('src/content/now/en.md is missing');
const { Content } = await render(entry);

const updated = entry.data.updated;
const updatedLabel = updated.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title={`Now — ${profile.name}`}
  description={`What ${profile.name} is focused on at the moment.`}
>
  <AxisGutter slot="axis" items={axisSiteItems} mode="site" />

  <article class="now">
    <header class="now__head">
      <p class="label">Now</p>
      <h1 class="now__title">What I'm working on</h1>
      <p class="label now__updated">
        Updated <time datetime={updated.toISOString().slice(0, 10)}>{updatedLabel}</time>
      </p>
    </header>
    <div class="now__body prose">
      <Content />
    </div>
  </article>

  <Contact />
</BaseLayout>

<style>
  .now {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-xl) var(--space-section);
  }

  .now__head {
    display: grid;
    gap: var(--space-2xs);
  }

  .now__title {
    font-size: var(--text-2xl);
  }

  .now__updated {
    font-size: var(--text-2xs);
  }

  .now__body {
    max-inline-size: var(--width-prose);
  }

  .now__body :global(ul) {
    display: grid;
    gap: var(--space-s);
    padding-inline-start: 1.1em;
  }
</style>
