---
import AxisGutter from '../components/AxisGutter.astro';
import { axisSiteItems } from '../data/nav';
import { getProfile } from '../data/profile';
import { toLocale, useTranslations } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import Projects from '../sections/03-Projects.astro';
import Contact from '../sections/07-Contact.astro';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const profile = getProfile(locale);
---

<BaseLayout
  title={`${t.pages.projects.title} — ${profile.name}`}
  description={t.pages.projects.description(profile.name)}
>
  <AxisGutter slot="axis" items={axisSiteItems} mode="site" current="/projects" />

  <!-- Same component as the home page, with no limit. -->
  <Projects as="h1" />
  <Contact />
</BaseLayout>
