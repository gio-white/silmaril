---
import AxisGutter from '../components/AxisGutter.astro';
import { axisSiteItems } from '../data/nav';
import { getProfile } from '../data/profile';
import { toLocale, useTranslations } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import Experience from '../sections/04-Experience.astro';
import Contact from '../sections/07-Contact.astro';

/**
 * Work history and education together, which is why the route is /experience
 * rather than /work — education appears here as a subheading rather than
 * getting a page nobody would visit.
 */
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const profile = getProfile(locale);
---

<BaseLayout
  title={`${t.pages.experience.title} — ${profile.name}`}
  description={t.pages.experience.description(profile.name, profile.role)}
>
  <AxisGutter slot="axis" items={axisSiteItems} mode="site" current="/experience" />

  <Experience as="h1" showEducation />
  <Contact />
</BaseLayout>
