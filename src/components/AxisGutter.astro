---
/**
 * The signature element: a chart axis running down the left edge, with the
 * content plotted against it.
 *
 * Two modes, one visual language:
 *   scroll — ticks are the sections of a long page; the current one fills as
 *            you scroll (see scripts/axis.ts).
 *   site   — ticks are the pages; the current one is marked server-side.
 *
 * Desktop labelled axis from 64rem. Below that it becomes a thin
 * scroll-progress rail rather than disappearing — same rust fill, no labels.
 */
export interface AxisItem {
  /** Section id for scroll mode, or href for site mode. */
  target: string;
  label: string;
}

interface Props {
  items: AxisItem[];
  mode: 'scroll' | 'site';
  /** Site mode only: the href of the page currently being viewed. */
  current?: string;
}

const { items, mode, current } = Astro.props;
---

<!-- Thin progress rail for viewports that cannot fit the labelled axis.
     Hidden from AT: the sticky header already exposes the same destinations. -->
<div class="axis-rail" aria-hidden="true">
  <div class="axis-rail__fill" data-axis-rail></div>
</div>

<nav class="axis" data-axis={mode} aria-label={mode === 'site' ? 'Site sections' : 'On this page'}>
  <ol class="axis__list">
    {
      items.map((item) => {
        const href = mode === 'scroll' ? `#${item.target}` : item.target;
        const isCurrent = mode === 'site' && item.target === current;
        return (
          <li class="axis__row">
            <a
              class:list={['axis__tick', { 'is-current': isCurrent }]}
              href={href}
              data-axis-tick={mode === 'scroll' ? item.target : undefined}
              aria-current={isCurrent ? 'page' : undefined}
            >
              <span class="axis__mark" aria-hidden="true" />
              <span class="axis__label">{item.label}</span>
            </a>
          </li>
        );
      })
    }
  </ol>
</nav>

<!-- Unconditional: Astro hoists <script> at build time, so wrapping one in a
     runtime condition is misleading - it ships either way. initAxis() exits
     immediately when there is no scroll-mode axis on the page. -->
<script>
  import { initAxis, initAxisRail } from '../scripts/axis';

  initAxis();
  initAxisRail();
</script>

<style>
  /*
   * Below 64rem the labelled axis has no horizontal room, so it is replaced
   * by a 2px scroll-progress rail on the inline-start edge. Same rust fill,
   * same hairline language — just without the tick labels.
   */
  .axis-rail {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: var(--z-axis);
    inline-size: 2px;
    pointer-events: none;
    background-color: var(--color-rule);
  }

  .axis-rail__fill {
    block-size: 100%;
    inline-size: 100%;
    background-color: var(--color-accent);
    transform: scaleY(0);
    transform-origin: top;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(html:not([data-reveal-js])) .axis-rail__fill {
        animation: axis-progress linear;
        animation-timeline: scroll();
      }
    }
  }

  @media (min-width: 64rem) {
    .axis-rail {
      display: none;
    }
  }

  .axis {
    display: none;
  }

  @media (min-width: 64rem) {
    .axis {
      display: block;
      position: sticky;
      inset-block-start: 6rem;
      align-self: start;
      /* The rule itself. Everything else hangs off it. */
      border-inline-start: var(--border-hair) solid var(--color-rule);
      padding-inline-start: var(--space-s);
    }
  }

  .axis__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-xs);
  }

  .axis__tick {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* The tick mark: a short rule that lengthens and takes the accent when
   * current. Length as well as colour, so the state is not carried by hue
   * alone. */
  .axis__mark {
    display: block;
    block-size: var(--border-hair);
    inline-size: 0.5rem;
    background-color: var(--color-rule-strong);
    transition:
      inline-size var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .axis__tick:hover {
    color: var(--color-text);
  }

  .axis__tick:hover .axis__mark {
    inline-size: 0.875rem;
    background-color: var(--color-text-muted);
  }

  .axis__tick.is-current {
    color: var(--color-accent);
  }

  .axis__tick.is-current .axis__mark {
    inline-size: 1.25rem;
    background-color: var(--color-accent);
  }
</style>
