{
  "name": "personal-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "astro dev",
    "build": "astro build && node scripts/localized-404.mjs && node scripts/csp-hashes.mjs && node scripts/check-budgets.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "astro check",
    "check": "biome check . && astro check",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "cv:pdf": "node scripts/cv-pdf.mjs",
    "rasterize": "node scripts/rasterize.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.2.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.8",
    "@types/three": "^0.185.4",
    "playwright-core": "1.64.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
